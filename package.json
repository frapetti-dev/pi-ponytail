{
	"name": "@frapetti-dev/pi-ponytail",
	"version": "1.0.0",
	"description": "ponytail for omp",
	"author": "frapetti-dev (https://github.com/frapetti-dev)",
	"type": "module",
	"files": [
		"extensions",
		"src",
		"skills",
		"vendor",
		"README.md"
	],
	"keywords": [
		"omp"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frapetti-dev/pi-ponytail.git"
	},
	"homepage": "https://github.com/frapetti-dev/pi-ponytail#readme",
	"license": "MIT",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"omp": {
		"extensions": [
			"./extensions/index.ts"
		],
		"settings": {
			"webhookUrl": {
				"type": "string",
				"default": "",
				"description": "Band webhook URL; https, or http on localhost/127.0.0.1/[::1]. Empty disables."
			},
			"webhookToken": {
				"type": "string",
				"default": "",
				"secret": true,
				"env": "PONYTAIL_WEBHOOK_TOKEN",
				"description": "Bearer token sent with the webhook."
			},
			"sendNames": {
				"type": "boolean",
				"default": true,
				"description": "Include the Task name in webhook payloads."
			}
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test --pass-with-no-tests",
		"sync-skills": "bun scripts/sync-skills.ts",
		"vendor": "bun scripts/vendor-upstream.ts"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": ">=19.2.1",
		"@oh-my-pi/pi-tui": ">=19.2.1"
	},
	"devDependencies": {
		"@dietrichgebert/ponytail": "5.3.3",
		"@oh-my-pi/pi-coding-agent": "19.2.1",
		"@oh-my-pi/pi-tui": "19.2.1",
		"@oh-my-pi/pi-wire": "19.2.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.3.0",
		"typescript": "^7.0.2"
	}
}
