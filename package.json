{
	"name": "@frapetti-dev/pi-ponytail",
	"version": "0.1.0",
	"description": "ponytail for omp",
	"author": "frapetti-dev (https://github.com/frapetti-dev)",
	"type": "module",
	"files": [
		"extensions",
		"src",
		"skills",
		"README.md"
	],
	"keywords": ["pi-package", "pi", "pi-extension", "omp"],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/frapetti-dev/pi-ponytail.git"
	},
	"homepage": "https://github.com/frapetti-dev/pi-ponytail#readme",
	"license": "MIT",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"omp": {
		"extensions": ["./extensions/index.ts"],
		"settings": {
			"webhookUrl": { "type": "string", "default": "", "description": "Band webhook URL; https, or http on localhost/127.0.0.1/[::1]. Empty disables." },
			"webhookToken": { "type": "string", "default": "", "secret": true, "env": "PONYTAIL_WEBHOOK_TOKEN", "description": "Bearer token sent with the webhook." },
			"sendNames": { "type": "boolean", "default": true, "description": "Include the Task name in webhook payloads." }
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "bun test --pass-with-no-tests",
		"sync-skills": "bun scripts/sync-skills.ts"
	},
	"dependencies": {
		"@dietrichgebert/ponytail": "5.3.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.84.0"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": { "optional": true }
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@types/bun": "^1.3.0",
		"@types/node": "^26.3.0",
		"typescript": "^7.0.2"
	}
}
